<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:XlsxEditor.App.Controls"
        x:Class="XlsxEditor.App.MainWindow"
        Title="XLSX Editor" Width="1100" Height="700"
        DragDrop.AllowDrop="True">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="OnOpenClick" />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClick" />
        <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Click="OnSaveAsClick" />
      </MenuItem>
      <!-- Gestures say Ctrl; on macOS they're shown and handled as Cmd (see MainWindow constructor). -->
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClick" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Shift+Z" Click="OnRedoClick" />
        <Separator />
        <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Click="OnCutClick" />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Click="OnCopyClick" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Click="OnPasteClick" />
        <MenuItem Header="_Delete" InputGesture="Delete" Click="OnClearClick" />
        <Separator />
        <MenuItem Header="_Edit Cell" InputGesture="F2" Click="OnEditCellClick" />
        <MenuItem Header="_Find…" InputGesture="Ctrl+F" Click="OnFindClick" />
      </MenuItem>
      <MenuItem Header="_Sheet">
        <MenuItem Header="_Next Sheet" InputGesture="Ctrl+PageDown" Click="OnNextSheetClick" />
        <MenuItem Header="_Previous Sheet" InputGesture="Ctrl+PageUp" Click="OnPrevSheetClick" />
        <Separator />
        <MenuItem Header="_Rename Sheet…" Click="OnRenameSheetClick" />
        <MenuItem Header="_Duplicate Sheet…" Click="OnDuplicateSheetClick" />
        <Separator />
        <MenuItem Header="Delete _Columns…" Click="OnDeleteColumnsClick" />
      </MenuItem>
      <MenuItem Header="_Data">
        <MenuItem Header="Find _Duplicates…" Click="OnFindDuplicatesClick" />
      </MenuItem>
    </Menu>

    <!-- Formula bar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="70,*" Margin="4">
      <TextBlock x:Name="AddressText" VerticalAlignment="Center" HorizontalAlignment="Center" Text="A1" />
      <!-- Shows the selected cell's content; mirrors the in-cell editor while typing. -->
      <TextBox x:Name="FormulaBox" Grid.Column="1" IsReadOnly="True" />
    </Grid>

    <!-- Find bar (Cmd/Ctrl+F) -->
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="4,0,4,4" IsVisible="False"
             PlaceholderText="Find…  (Enter = next, Shift+Enter = previous, Esc = close)" />

    <!-- One-line input for sheet commands (rename, duplicate, delete columns) -->
    <TextBox x:Name="PromptBox" DockPanel.Dock="Top" Margin="4,0,4,4" IsVisible="False" />

    <!-- Sheet tabs (double-click to rename) + status -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="4,2">
      <TabStrip x:Name="SheetTabs" SelectionChanged="OnSheetChanged" />
      <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" />
    </Grid>

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
      <c:SheetGrid x:Name="Sheet" />
      <!-- In-cell editor: type on a cell, double-click it, or press F2. Enter/Tab = save, Esc = cancel. -->
      <Canvas ClipToBounds="True">
        <TextBox x:Name="CellEditor" IsVisible="False" MinHeight="0" Padding="3,0" FontSize="13"
                 VerticalContentAlignment="Center" CornerRadius="0" BorderThickness="2"
                 BorderBrush="#107C41" Background="White" />
      </Canvas>
      <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical" Minimum="1" SmallChange="1" />
      <ScrollBar x:Name="HScroll" Grid.Row="1" Orientation="Horizontal" Minimum="1" SmallChange="1" />
    </Grid>
  </DockPanel>
</Window>
