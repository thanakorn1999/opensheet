<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OpenSheet.App.Controls"
        x:Class="OpenSheet.App.MainWindow"
        Title="OpenSheet" Width="1100" Height="700" Icon="avares://OpenSheet.App/Assets/icon.png"
        DragDrop.AllowDrop="True">
  <Window.Styles>
    <!-- Fluent's tabs are headline-sized; sheet tabs should look like a status bar. -->
    <Style Selector="TabStrip#SheetTabs TabStripItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Button.tabnav">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="OnOpenClick" />
        <MenuItem Header="_Import / Append from Workbook…" Click="OnImportClick" />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClick" />
        <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Click="OnSaveAsClick" />
      </MenuItem>
      <!-- Gestures say Ctrl; on macOS they're shown and handled as Cmd (see MainWindow constructor). -->
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClick" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Shift+Z" Click="OnRedoClick" />
        <Separator />
        <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Click="OnCutClick" />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Click="OnCopyClick" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Click="OnPasteClick" />
        <MenuItem Header="_Delete" InputGesture="Delete" Click="OnClearClick" />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Click="OnSelectAllClick" />
        <Separator />
        <MenuItem Header="_Edit Cell" InputGesture="F2" Click="OnEditCellClick" />
        <MenuItem Header="_Find…" InputGesture="Ctrl+F" Click="OnFindClick" />
      </MenuItem>
      <MenuItem Header="_Sheet">
        <MenuItem Header="_Next Sheet" InputGesture="Ctrl+PageDown" Click="OnNextSheetClick" />
        <MenuItem Header="_Previous Sheet" InputGesture="Ctrl+PageUp" Click="OnPrevSheetClick" />
        <Separator />
        <MenuItem Header="Ne_w Sheet" InputGesture="Shift+F11" Click="OnNewSheetClick" />
        <MenuItem Header="_Rename Sheet…" Click="OnRenameSheetClick" />
        <MenuItem Header="_Duplicate Sheet…" Click="OnDuplicateSheetClick" />
        <MenuItem Header="Delete S_heet" Click="OnDeleteSheetClick" />
        <MenuItem Header="Move Sheet _Left" Click="OnMoveSheetLeftClick" />
        <MenuItem Header="Move Sheet Righ_t" Click="OnMoveSheetRightClick" />
        <Separator />
        <MenuItem Header="Insert Rows _Above" Click="OnInsertRowsClick" />
        <MenuItem Header="Insert C_olumns Left" Click="OnInsertColumnsClick" />
        <MenuItem Header="Delete Ro_ws" Click="OnDeleteRowsClick" />
        <MenuItem Header="Delete _Columns" Click="OnDeleteColumnsClick" />
      </MenuItem>
      <MenuItem Header="_Data">
        <MenuItem Header="Find _Duplicates…" Click="OnFindDuplicatesClick" />
      </MenuItem>
    </Menu>

    <!-- Formula bar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="110,*" Margin="4">
      <TextBlock x:Name="AddressText" VerticalAlignment="Center" HorizontalAlignment="Center" Text="A1" TextTrimming="CharacterEllipsis" />
      <!-- Shows the selected cell's content; mirrors the in-cell editor while typing. -->
      <TextBox x:Name="FormulaBox" Grid.Column="1" IsReadOnly="True" />
    </Grid>

    <!-- Find bar (Cmd/Ctrl+F) -->
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="4,0,4,4" IsVisible="False"
             PlaceholderText="Find…  (Enter = next, Shift+Enter = previous, Esc = close)" />

    <!-- One-line input for sheet commands (rename, duplicate, delete columns) -->
    <TextBox x:Name="PromptBox" DockPanel.Dock="Top" Margin="4,0,4,4" IsVisible="False" />

    <!-- Scroll + new-sheet buttons (always visible) + sheet tabs (double-click to rename, right-click for more, drag to reorder) + status.
         The tab scroller hides its bar (it would cover the tabs); the mouse wheel, trackpad and ‹ › scroll it. -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tabnav" Content="‹" ToolTip.Tip="Scroll sheet tabs left" Click="OnTabsLeftClick" />
        <Button Classes="tabnav" Content="›" ToolTip.Tip="Scroll sheet tabs right" Click="OnTabsRightClick" />
        <Button Classes="tabnav" Content="+" ToolTip.Tip="New sheet (Shift+F11)" Click="OnNewSheetClick" />
      </StackPanel>
      <ScrollViewer x:Name="TabScroller" Grid.Column="1" Margin="4,0"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <TabStrip x:Name="SheetTabs" SelectionChanged="OnSheetChanged">
          <TabStrip.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </TabStrip.ItemsPanel>
        </TabStrip>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="8,0"
                 MaxWidth="380" TextTrimming="CharacterEllipsis" />
    </Grid>

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
      <c:SheetGrid x:Name="Sheet" />
      <!-- In-cell editor: type on a cell, double-click it, or press F2. Enter/Tab = save, Esc = cancel. -->
      <Canvas ClipToBounds="True">
        <TextBox x:Name="CellEditor" IsVisible="False" MinHeight="0" Padding="3,0" FontSize="13"
                 VerticalContentAlignment="Center" CornerRadius="0" BorderThickness="2"
                 BorderBrush="#107C41" Background="White" />
      </Canvas>
      <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical" Minimum="1" SmallChange="1" />
      <ScrollBar x:Name="HScroll" Grid.Row="1" Orientation="Horizontal" Minimum="1" SmallChange="1" />
    </Grid>
  </DockPanel>
</Window>
